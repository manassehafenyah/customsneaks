# Cloudflare Pages reads this file. Long cache for assets, short for the page
# itself so edits show up straight away.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/data/*
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=60

/
  Cache-Control: public, max-age=60
